diff --git a/internal/infrastructure/persistence/prompt/repo.go b/internal/infrastructure/persistence/prompt/repo.go
index 8e30b43c..1f51e071 100644
--- a/internal/infrastructure/persistence/prompt/repo.go
+++ b/internal/infrastructure/persistence/prompt/repo.go
@@ -960,6 +960,11 @@ func applyPromptBaseFilters(tx *gorm.DB, q domainrepo.PromptQuery) *gorm.DB {
 		like := "%" + q.Keyword + "%"
 		tx = tx.Where("title LIKE ? OR prompt LIKE ?", like, like)
 	}
+	for _, term := range q.Keywords {
+		// A keyword is literal text, never a caller-provided LIKE wildcard.
+		like := "%" + strings.NewReplacer("!", "!!", "%", "!%", "_", "!_").Replace(term) + "%"
+		tx = tx.Where("(title LIKE ? ESCAPE '!' OR prompt LIKE ? ESCAPE '!' OR tags LIKE ? ESCAPE '!')", like, like, like)
+	}
 	if isActivePromptOption(q.Category) {
 		tx = tx.Where("category = ?", q.Category)
 	}
